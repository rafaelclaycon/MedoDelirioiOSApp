# Server credentials for auto_transcribe.sh SFTP upload.
# Copy this file to scripts/.env and fill in your values.
# NEVER commit scripts/.env to version control.

SFTP_HOST="your-server.example.com"
SFTP_USER="your-username"
SFTP_PORT="22"
SFTP_KEY="/Users/rafaelschmitt/.ssh/id_ed25519"
SFTP_REMOTE_DIR="/path/to/transcripts/v1"

# Chapter generation (optional). Leave ANTHROPIC_API_KEY or CHAPTERS_REMOTE_DIR
# empty and auto_transcribe.sh publishes transcripts as usual, just without
# generating chapters.
ANTHROPIC_API_KEY=""
CHAPTERS_REMOTE_DIR="/path/to/chapters/v1"
# Python that has `anthropic` and `pydantic` installed. launchd does not inherit
# your shell, so point this at a venv rather than relying on PATH.
CHAPTERS_PYTHON="/Users/rafaelschmitt/MedoDelirioChapters/.venv/bin/python"
