<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.rafaelschmitt.autotranscribe</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/rafaelschmitt/Projects/MedoDelirioBrasilia/scripts/auto_transcribe.sh</string>
	</array>

	<!-- Run every 1200 seconds (20 minutes) -->
	<key>StartInterval</key>
	<integer>1200</integer>

	<key>StandardOutPath</key>
	<string>/Users/rafaelschmitt/MedoDelirioTranscripts/logs/launchd.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/rafaelschmitt/MedoDelirioTranscripts/logs/launchd_err.log</string>

	<!-- Ensure PATH includes Homebrew Python and standard tools -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
